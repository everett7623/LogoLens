{
  "manifest_version": 3,
  "name": "LogoLens - 网站 Logo 提取器",
  "short_name": "LogoLens",
  "version": "0.1.0",
  "description": "一键提取当前网站的 Logo、Favicon 和应用图标。由 everettlabs 出品。",
  "author": "everettlabs",
  "homepage_url": "https://everettlabs.dev/",
  "permissions": ["activeTab", "scripting", "downloads"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "提取网站 Logo",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
